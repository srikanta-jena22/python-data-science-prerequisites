   "source": [
    "# Solution 4: einsum example\n",
    "A = np.random.rand(2,3,4)\n",
    "B = np.random.rand(2,4,5)\n",
    "## We want batch matrix-multiply on axis: for each i in 0..1 compute A[i] (3x4) @ B[i] (4x5) -> (3x5)\n",
    "C = np.einsum('ijk,ikl->ijl', A, B)\n",
    "print('C shape (batch matmul):', C.shape)\n"
   ],
