   },
   "source": [
    "# Solution 2: pairwise squared distances\n",
    "x = np.array([1,2,3])\n",
    "y = np.array([2,4])\n",
    "d2 = (x[:,None] - y[None,:])**2\n",
    "print('pairwise squared distances:\\n', d2)\n"
