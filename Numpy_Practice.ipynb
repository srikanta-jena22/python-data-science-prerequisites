  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-09-24T03:05:19.507617Z",
     "start_time": "2025-09-24T03:05:19.501700Z"
    }
   },
   "source": [
    "# Solution 1: 5x5 with border zero\n",
    "mat = np.arange(1,26).reshape(5,5)\n",
    "mat[[0,-1],:] = 0\n",
    "mat[:,[0,-1]] = 0\n",
    "print(mat)\n"
   ],
